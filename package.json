{
  "name": "silk-icons-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Fast, keyboard-driven search browser for the FamFamFam Silk icon set.",
  "scripts": {
    "dev": "npm run build:data && vite",
    "build": "npm run build:data && vite build",
    "preview": "vite preview",
    "build:data": "node scripts/build-sprite.mjs && node scripts/build-catalog.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tsconfig/svelte": "^5.0.5",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
