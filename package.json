{
	"name": "silk-icons-browser",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"description": "Fast, keyboard-driven icon browser for the FamFamFam Silk icon set.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Be1zebub/silk-icons-browser.git"
	},
	"homepage": "https://silk.bzbb.dev",
	"bugs": {
		"url": "https://github.com/Be1zebub/silk-icons-browser/issues"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"serve": "node scripts/serve.mjs",
		"build:data": "node scripts/build-sprite.mjs && node scripts/build-catalog.mjs",
		"build:og": "node scripts/build-og.mjs",
		"bench": "node scripts/bench.mjs",
		"probe": "node scripts/probe.mjs",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "node --test \"tests/**/*.test.mjs\"",
		"verify": "npm run check && npm test && npm run build"
	},
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.2.8",
		"@lucide/svelte": "^1.59.0"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tsconfig/svelte": "^5.0.5",
		"@types/node": "^26.6.5",
		"playwright": "^1.64.1",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.6.0",
		"vite": "^7.0.0"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"workerd@1.20261019.1": true
	}
}
